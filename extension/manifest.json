{
  "manifest_version": 3,
  "name": "PyIDM Integration",
  "version": "1.1.0",
  "description": "Tombol download di pojok kanan atas video, dikirim ke aplikasi PyIDM.",
  "permissions": ["webRequest", "storage", "cookies", "contextMenus", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "PyIDM" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
}
